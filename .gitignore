# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.cache/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GeoNames source dumps (regenerate with npm run build:us-geonames)
/scripts/source/*.txt

# Swiss Ephemeris binaries（本地可运行 npm run ephe:fetch 生成；未生成时客户端会回退镜像）
/public/swiss-ephe/*.se1

# tarot:money:freeze 临时 bundle
/scripts/.freeze-money-registers.cjs
/scripts/.freeze-career-registers.cjs
# tarot:study:freeze 临时 bundle
/scripts/.freeze-study-registers.cjs
/scripts/.emit-life-six-layers.cjs
/scripts/.freeze-life-six-registers.cjs
/scripts/.emit-life-six-master-handbook.cjs
/scripts/.lint-life-six-health-rubric.cjs
/scripts/.lint-life-six-b-rubric.cjs
/scripts/.verify-numerology.cjs
/scripts/.*.cjs

.vercel

# local build cache and scratch
/.next-dev/
__pycache__/
/tmp-*
/_tmp_*

# kept on this computer; omitted from GitHub so Bolt can import (text limit 7.8 MB)
/public/tarotQuestionResolve.js
/public/tarotQuestionWestern.js
